# Normalize line endings for text files; keep CRLF-free history.
* text=auto

# Unreal source/config/data are text
*.cpp  text
*.h    text
*.cs   text
*.ini  text
*.uproject text
*.uplugin  text
*.py   text
*.json text
*.csv  text
*.md   text

# ---------------------------------------------------------------
# Git LFS: binary assets
# ---------------------------------------------------------------
# Unreal packages
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uexp   filter=lfs diff=lfs merge=lfs -text

